# When the app is embedded (e.g. marketplace iframe), set this to your app's public URL so Connect opens in a new tab to the correct origin.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=

# Feature flag: set to "true" or "1" to show "Generate task breakdown with AI" in the create-task view. When unset or false, only normal task creation is shown.
NEXT_PUBLIC_ENABLE_AI_TASK_CREATION=

# Optional: for AI-powered work breakdown (parse requirements). Add to .env.local when using real AI instead of stub.
OPENAI_API_KEY=

