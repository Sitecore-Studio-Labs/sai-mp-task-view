#!/bin/sh
# Prevent merging develop/main INTO a feature branch.
# Keeps git history linear — use `git rebase origin/develop` instead.

CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
MERGE_HEAD=$(cat .git/MERGE_HEAD 2>/dev/null)

if [ -z "$MERGE_HEAD" ]; then
  exit 0
fi

# Allow merges on develop and main (e.g. release PR merges)
case "$CURRENT_BRANCH" in
  develop|main) exit 0 ;;
esac

# Identify what is being merged
MERGING_BRANCH=$(git name-rev --name-only "$MERGE_HEAD" 2>/dev/null | sed 's|remotes/origin/||')

case "$MERGING_BRANCH" in
  develop|main|origin/develop|origin/main)
    echo ""
    echo "✗ Merge blocked: you are trying to merge '$MERGING_BRANCH' into '$CURRENT_BRANCH'."
    echo ""
    echo "  This creates a merge commit and breaks the linear history required by this repo."
    echo "  Use rebase instead:"
    echo ""
    echo "      git merge --abort"
    echo "      git fetch origin"
    echo "      git rebase origin/develop"
    echo ""
    echo "  If you hit conflicts, resolve them and run: git rebase --continue"
    echo ""
    exit 1
    ;;
esac
