#!/bin/sh
# Prevent pushing a feature branch that contains merge commits.
# Catches the case where someone bypassed pre-merge-commit with --no-verify.

CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)

# Only enforce on feature/fix/chore/refactor/docs/test/perf/build/ci branches
case "$CURRENT_BRANCH" in
  develop|main) exit 0 ;;
esac

# Check for merge commits between develop and HEAD
MERGE_COMMITS=$(git log origin/develop..HEAD --merges --oneline 2>/dev/null)

if [ -n "$MERGE_COMMITS" ]; then
  echo ""
  echo "✗ Push blocked: your branch '$CURRENT_BRANCH' contains merge commit(s):"
  echo ""
  echo "$MERGE_COMMITS" | sed 's/^/    /'
  echo ""
  echo "  Merge commits break the linear history required by this repo."
  echo "  Clean up your branch before pushing:"
  echo ""
  echo "      git rebase origin/develop"
  echo ""
  echo "  If conflicts arise, resolve them and run: git rebase --continue"
  echo "  If you need to remove an already-created merge commit:"
  echo ""
  echo "      git rebase --onto origin/develop \$(git merge-base HEAD origin/develop) HEAD"
  echo ""
  exit 1
fi
