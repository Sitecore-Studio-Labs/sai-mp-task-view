{
  "name": "jira-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/jira-e2e/src",
  "implicitDependencies": ["jira"],
  "targets": {
    "e2e": {
      "executor": "@nx/playwright:playwright",
      "outputs": ["{workspaceRoot}/dist/.playwright/apps/jira-e2e"],
      "options": {
        "config": "apps/jira-e2e/playwright.config.ts"
      }
    },
    "e2e-ui": {
      "executor": "@nx/playwright:playwright",
      "outputs": ["{workspaceRoot}/dist/.playwright/apps/jira-e2e"],
      "options": {
        "config": "apps/jira-e2e/playwright.config.ts",
        "ui": true
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["apps/jira-e2e/**/*.ts"]
      }
    }
  },
  "tags": ["scope:jira", "type:e2e"]
}
