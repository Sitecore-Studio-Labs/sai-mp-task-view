# ── Azure PostgreSQL ──────────────────────────────────────────────────────────
# Server-only. Do not prefix with NEXT_PUBLIC_ — the browser must never see this.
DATABASE_URL=postgresql://app_user:<password>@<host>.postgres.database.azure.com:5432/<db>?sslmode=require

# ── Jira OAuth ────────────────────────────────────────────────────────────────
# Create an OAuth 2.0 (3LO) app at https://developer.atlassian.com/console/myapps/
JIRA_CLIENT_ID=<client-id>
JIRA_CLIENT_SECRET=<client-secret>
# Must exactly match the callback URL registered in your Atlassian app
JIRA_REDIRECT_URI=http://localhost:3000/api/auth/jira/callback

# ── Jira Webhooks (optional) ──────────────────────────────────────────────────
# Set a secret when registering webhooks with Jira. If absent, signature
# verification is skipped (acceptable for local dev; required in production).
# Must be at least 16 characters.
# JIRA_WEBHOOK_SECRET=<random-secret-min-16-chars>

# ── AI work breakdown (optional) ─────────────────────────────────────────────
# Omit to use the built-in stub (no OpenAI call, deterministic output).
# OPENAI_API_KEY=sk-...

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Observability ─────────────────────────────────────────────────────────────
# Semver or git SHA injected at build time (e.g. in CI: NEXT_PUBLIC_APP_VERSION=$GITHUB_SHA)
# NEXT_PUBLIC_APP_VERSION=0.1.0

# Force console exporter in production (default: only active in development)
# NEXT_PUBLIC_ENABLE_CONSOLE_LOGGING=false

# Google Analytics 4 — enables GoogleAnalyticsExporter
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# OTLP endpoint for Grafana Tempo / Jaeger / Honeycomb (server-side only)
# OTEL_EXPORTER_OTLP_ENDPOINT=https://tempo.your-domain.com
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <token>

# Pino log level: debug | info | warn | error | fatal (default: info)
# LOG_LEVEL=info
