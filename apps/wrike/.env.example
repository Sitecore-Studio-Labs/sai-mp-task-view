# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ── Wrike OAuth ───────────────────────────────────────────────────────────────
# Create an OAuth 2.0 app in Wrike: Profile → Apps & Integrations → API → + App
# OAuth docs: https://developers.wrike.com/docs/oauth-20-authorization
WRIKE_CLIENT_ID=<client-id>
WRIKE_CLIENT_SECRET=<client-secret>
# Must exactly match the callback URL registered in your Wrike app
WRIKE_REDIRECT_URI=http://localhost:3000/api/auth/wrike/callback

# ── Wrike Webhooks (optional) ─────────────────────────────────────────────────
# Used for live UI sync: Wrike → POST /api/webhooks/wrike → Supabase Realtime.
# Set a secret when registering webhooks with Wrike. If absent, signature
# verification is skipped (acceptable for local dev; required in production).
# Must be at least 16 characters. NEXT_PUBLIC_APP_URL must be publicly reachable
# (Wrike rejects localhost callback URLs).
# WRIKE_WEBHOOK_SECRET=<random-secret-min-16-chars>

# ── AI work breakdown (optional) ─────────────────────────────────────────────
# Omit to use the built-in stub (no OpenAI call, deterministic output).
# OPENAI_API_KEY=sk-...

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Observability ─────────────────────────────────────────────────────────────
# Semver or git SHA injected at build time (e.g. in CI: NEXT_PUBLIC_APP_VERSION=$GITHUB_SHA)
# NEXT_PUBLIC_APP_VERSION=0.1.0

# Force console exporter in production (default: only active in development)
# NEXT_PUBLIC_ENABLE_CONSOLE_LOGGING=false

# Google Analytics 4 — enables GoogleAnalyticsExporter
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# OTLP endpoint for Grafana Tempo / Jaeger / Honeycomb (server-side only)
# OTEL_EXPORTER_OTLP_ENDPOINT=https://tempo.your-domain.com
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <token>

# Pino log level: debug | info | warn | error | fatal (default: info)
# LOG_LEVEL=info
