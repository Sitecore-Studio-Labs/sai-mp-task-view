{
  "name": "task-core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/task-core/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:feature"],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["libs/task-core/**/*.ts", "libs/task-core/**/*.tsx"]
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "outputs": ["{workspaceRoot}/coverage/libs/task-core"],
      "options": {
        "passWithNoTests": true,
        "reportsDirectory": "../../coverage/libs/task-core"
      }
    }
  }
}
