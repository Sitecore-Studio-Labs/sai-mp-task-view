"use client";

import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
import axios from "axios";
import { useState } from "react";

<%_ if (hasOAuth) { _%>
import { <%= className %>AuthFailureProvider } from "@/providers/auth-providers/<%= className %>AuthFailureProvider";
<%_ } _%>
import { <%= className %>PlatformApiProvider } from "@/providers/<%= className %>PlatformApiProvider";

const retryUnless401 = (failureCount: number, error: Error) => {
  if (axios.isAxiosError(error) && error.response?.status === 401) return false;
  return failureCount < 1;
};

export function Providers({ children }: { children: React.ReactNode }) {
  const [queryClient] = useState(
    () =>
      new QueryClient({
        defaultOptions: {
          queries: { refetchOnWindowFocus: false, retry: retryUnless401 },
          mutations: { retry: retryUnless401 },
        },
      }),
  );

  return (
    <QueryClientProvider client={queryClient}>
      <<%= className %>PlatformApiProvider>
        <%_ if (hasOAuth) { _%>
        <<%= className %>AuthFailureProvider>{children}</<%= className %>AuthFailureProvider>
        <%_ } else { _%>
        {children}
        <%_ } _%>
      </<%= className %>PlatformApiProvider>
    </QueryClientProvider>
  );
}
