<%_ if (hasOAuth) { _%>
import { NextRequest } from "next/server";

import { <%= constantName %>_SESSION_COOKIE } from "@/helpers/cookies";
import { create<%= className %>TokenStore } from "@/lib/tokenStore";

/**
 * Resolves the userId from the <%= platformDisplay %> session cookie.
 * Returns null if the request has no valid session (user not connected).
 * Used by withAdapter in platformRoute.ts.
 */
export async function get<%= className %>UserIdFromSession(
  request: NextRequest,
): Promise<string | null> {
  const sessionToken = request.cookies.get(<%= constantName %>_SESSION_COOKIE)?.value;
  if (!sessionToken) return null;
  const store = create<%= className %>TokenStore();
  const session = await store.lookupSession(sessionToken);
  return session?.accountId ?? null;
}
<%_ } else { _%>
import { NextRequest } from "next/server";

// TODO: implement user ID resolution for <%= platformDisplay %>'s auth strategy.
// This function must return the userId (the key used to look up the user's stored
// connection in Azure PostgreSQL) or null if the request is unauthenticated.
//
// Common patterns:
//   - API key in header: extract from request.headers.get("x-api-key") and look up owner
//   - Session JWT: decode from Authorization header or cookie
//   - Personal Access Token: similar to API key

export async function get<%= className %>UserIdFromSession(
  _request: NextRequest,
): Promise<string | null> {
  // TODO: replace with the actual userId resolution for <%= platformDisplay %>
  throw new Error("get<%= className %>UserIdFromSession: not implemented");
}
<%_ } _%>
