    const { adapter, token } = await get<%= className %>ApiContext(this.userId);
    const raw = await adapter.createComment(token, _payload.issueIdOrKey, _payload.text);
    return normalizeComment(raw as Parameters<typeof normalizeComment>[0]);
    <%_ } else if (hasComments) { _%>
    // TODO: implement — call adapter.createComment and map result to PlatformComment
    throw new Error("<%= className %>ServiceAdapter.createComment not implemented");
    <%_ } else { _%>
    throw new Error("<%= className %>ServiceAdapter.createComment not implemented");
    <%_ } _%>
