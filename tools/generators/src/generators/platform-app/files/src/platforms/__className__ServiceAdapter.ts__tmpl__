export type UserId = string;

export class <%= className %>ServiceAdapter implements PlatformServiceAdapter {
  constructor(private readonly userId: UserId) {}

  // ── Core ──────────────────────────────────────────────────────────────────

  async getProjects(): Promise<PlatformProject[]> {
    const { adapter, token } = await get<%= className %>ApiContext(this.userId);
    // TODO: map platform projects to PlatformProject[] if the shapes differ
    return adapter.getProjects(token) as unknown as PlatformProject[];
  }

  async getTasks(
    projectKey: string,
    cursor?: string,
    _filters?: Partial<TaskFilters>,
  ): Promise<PlatformTasksPageResponse> {
    const { adapter, token } = await get<%= className %>ApiContext(this.userId);
    // TODO: pass cursor and filters through to the adapter
    const result = await adapter.getTasks(token, projectKey);
    <%_ if (hasApiYaml) { _%>
    return { issues: result.map(normalizeTask as (r: unknown) => PlatformTask), isLast: true };
    <%_ } else { _%>
    // TODO: map result items to PlatformTask[] using a normalizeTask() function
    return { issues: result as unknown as PlatformTask[], isLast: true };
    <%_ } _%>
  }

  async getTask(taskId: string): Promise<PlatformTask> {
    const { adapter, token } = await get<%= className %>ApiContext(this.userId);
    const raw = await adapter.getTaskById(token, taskId);
    <%_ if (hasApiYaml) { _%>
    return normalizeTask(raw as Parameters<typeof normalizeTask>[0]);
    <%_ } else { _%>
    // TODO: map raw to PlatformTask using a normalizeTask() function
    return raw as unknown as PlatformTask;
    <%_ } _%>
  }

