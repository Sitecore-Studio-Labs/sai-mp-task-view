  PlatformServiceAdapter,
  PlatformTask,
  PlatformTasksPageResponse,
  PlatformTransition,
  PlatformUser,
  PriorityOption,
  TaskFilters,
  UpdateTaskPayload,
} from "@mp/task-core";

<%_ if (hasApiYaml && hasRequiresResolution) { _%>
// --- @generated normalizer imports (generate-mappings) ---
import {
  normalizeCommentWithEmptyMaps,
  normalizeProject,
  normalizeTaskWithEmptyMaps,
} from "@/platforms/<%= name %>/generated";
// --- end @generated normalizer imports ---
<%_ } else if (hasApiYaml) { _%>
import { normalizeComment, normalizeProject, normalizeTask } from "@/platforms/<%= name %>/generated";
<%_ } _%>
import { get<%= className %>ApiContext } from "@/services/<%= name %>Service";
<%_ if (hasApiYaml && hasComments && commentCreateInBody) { _%>
import type { <%= commentCreatePayloadType %> } from "@/types/<%= name %>";
<%_ } _%>

export type UserId = string;
<%_ if (hasApiYaml && hasEnrichmentTransforms) { _%>

// ── Enrichment helpers ────────────────────────────────────────────────────────
// The platform returns IDs for related entities (users, statuses, etc.) rather
// than full objects. These helpers pre-fetch lookup maps so the normalizers
// receive resolved objects instead of bare ID strings.
//
// TODO: Fill in the correct adapter calls and map shapes for this platform.
// See capabilities/<%= name %>.api.yaml for transform annotations on each field.

type EnrichmentContext = Record<string, Map<string, unknown>>;

async function buildEnrichmentContext(
  _adapter: unknown,
  _token: unknown,
  _items: unknown[],
): Promise<EnrichmentContext> {
  // TODO: Fetch the data needed to resolve ID references in the normalizer.
  // Example pattern:
  //   const workflows = await _adapter.getWorkflows(_token);
  //   const statusMap = new Map(workflows.flatMap(w => w.statuses).map(s => [s.id, s]));
  //   const contactIds = [...new Set(_items.flatMap(t => [...(t.responsibleIds ?? []), ...(t.authorIds ?? [])]))];
  //   const contacts = await _adapter.getContacts(_token, contactIds);
  //   const contactMap = new Map(contacts.map(c => [c.id, c]));
  //   return { statusMap, contactMap };
  return {};
}
<%_ } _%>

export class <%= className %>ServiceAdapter implements PlatformServiceAdapter {
  constructor(private readonly userId: UserId) {}

  // ── Core ──────────────────────────────────────────────────────────────────

  async getProjects(_siteId?: string): Promise<PlatformProject[]> {
    <%_ if (hasApiYaml) { _%>
    const { adapter, token } = await get<%= className %>ApiContext(this.userId);
    const folders = await adapter.getProjects(token);
    return folders.map(normalizeProject);
    <%_ } else { _%>
    // TODO: implement — fetch projects from the platform and map to PlatformProject[]
    return [];
    <%_ } _%>
  }

  async getTasks(
    projectKey: string,
    cursor?: string,
    _filters?: Partial<TaskFilters>,
  ): Promise<PlatformTasksPageResponse> {
    const { adapter, token } = await get<%= className %>ApiContext(this.userId);
    <%_ if (hasApiYaml && !hasEnrichmentTransforms) { _%>
    const page = await adapter.<%= taskListMethod %>(token, projectKey, cursor);
    const rawItems = page.<%= taskPageKey %>;
    const issues = rawItems.map((t) =>
      normalizeTask(t as Parameters<typeof normalizeTask>[0]),
    );
    return {
      issues,
      nextPageToken: page.<%= paginationParam %>,
      isLast: !page.<%= paginationParam %>,
    };
    <%_ } else { _%>
    // TODO: implement — call adapter.<%= taskListMethod %>, fetch enrichment context (statusMap, contactMap, etc.),
    // then map items using the appropriate normalizer with resolved entities.
    // See buildEnrichmentContext and capabilities/<%= name %>.api.yaml for patterns.
    return { issues: [], isLast: true };
    <%_ } _%>
  }

  async getTask(taskId: string): Promise<PlatformTask> {
    const { adapter, token } = await get<%= className %>ApiContext(this.userId);
    <%_ if (hasApiYaml && !hasEnrichmentTransforms) { _%>
    const raw = await adapter.<%= taskByIdMethod %>(token, taskId);
    return normalizeTask(raw as Parameters<typeof normalizeTask>[0]);
    <%_ } else { _%>
    // TODO: implement — fetch the task, build enrichment context (statusMap, contactMap, etc.),
    // then normalize using the appropriate normalizer with resolved entities.
    // See buildEnrichmentContext and capabilities/<%= name %>.api.yaml for patterns.
    return {} as PlatformTask;
    <%_ } _%>
  }

  async createTask(_payload: CreateTaskPayload): Promise<CreateTaskResult> {
    // TODO: implement — map _payload fields to the platform's create-task API
    throw new Error("<%= className %>ServiceAdapter.createTask not implemented");
  }

  async updateTask(_taskId: string, _payload: UpdateTaskPayload): Promise<PlatformTask> {
