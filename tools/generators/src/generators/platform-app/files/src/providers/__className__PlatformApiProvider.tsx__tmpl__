"use client";

import { PlatformApiProvider } from "@mp/task-core";
import type { ReactNode } from "react";

import { apiClient } from "@/lib/axiosClient";
import { <%= constantName %>_API_PATHS } from "@/lib/apiPaths";

export function <%= className %>PlatformApiProvider({ children }: { children: ReactNode }) {
  return (
    <PlatformApiProvider paths={<%= constantName %>_API_PATHS} client={apiClient}>
      {children}
    </PlatformApiProvider>
  );
}
