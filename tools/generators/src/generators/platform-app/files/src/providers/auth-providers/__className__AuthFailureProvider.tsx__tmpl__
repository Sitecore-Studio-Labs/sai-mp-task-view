"use client";

import {
  AlertDialog,
  AlertDialogCancel,
  AlertDialogContent,
  AlertDialogDescription,
  AlertDialogFooter,
  AlertDialogHeader,
  AlertDialogTitle,
  Button,
  useClientOriginUrl,
} from "@mp/ui";
import { useQueryClient } from "@tanstack/react-query";
import { useCallback, useEffect, useState } from "react";
import { toast } from "sonner";

// TODO: Import your platform-specific axiosClient and setOnAuthFailureCallback.
// import { setOnAuthFailureCallback } from "@/lib/axiosClient";

const POPUP_NAME = "<%= platform %>_reconnect";
const POPUP_SPEC = "width=600,height=700,scrollbars=yes,resizable=yes";

const allowedOrigin = (): string =>
  (
    process.env.NEXT_PUBLIC_APP_URL ?? (typeof window !== "undefined" ? window.location.origin : "")
  ).replace(/\/$/, "");

export function <%= className %>AuthFailureProvider({ children }: { children: React.ReactNode }) {
  const [showPopup, setShowPopup] = useState(false);
  const queryClient = useQueryClient();
  const connectUrl = useClientOriginUrl("/api/auth/<%= platform %>/connect");

  // TODO: Wire up to your axiosClient auth-failure callback:
  // useEffect(() => {
  //   setOnAuthFailureCallback(() => setShowPopup(true));
  //   return () => setOnAuthFailureCallback(null);
  // }, []);

  useEffect(() => {
    if (typeof window === "undefined") return;

    const onMessage = (event: MessageEvent) => {
      if (event.origin !== allowedOrigin()) return;

      if (event.data?.type === "OAUTH_CONNECTED" && event.data?.platform === "<%= platform %>") {
        setShowPopup(false);
        // TODO: Invalidate your platform-specific connection query keys here.
        void queryClient;
        toast.success("<%= platformDisplay %> connected successfully.");
      }
    };

    window.addEventListener("message", onMessage);
    return () => window.removeEventListener("message", onMessage);
  }, [queryClient]);

  const handleReconnect = useCallback(() => {
    if (!connectUrl) return;
    const popup = window.open(connectUrl, POPUP_NAME, POPUP_SPEC);
    if (!popup || popup.closed) {
      window.location.href = connectUrl;
    }
  }, [connectUrl]);

  return (
    <>
      {children}
      <AlertDialog open={showPopup} onOpenChange={setShowPopup}>
        <AlertDialogContent>
          <AlertDialogHeader>
            <AlertDialogTitle><%= platformDisplay %> session expired</AlertDialogTitle>
            <AlertDialogDescription>
              Your <%= platformDisplay %> session has expired or the connection was lost. Please
              reconnect to continue.
            </AlertDialogDescription>
          </AlertDialogHeader>
          <AlertDialogFooter>
            <AlertDialogCancel onClick={() => setShowPopup(false)}>Dismiss</AlertDialogCancel>
            <Button onClick={handleReconnect} disabled={!connectUrl}>
              {connectUrl ? "Reconnect <%= platformDisplay %>" : "Loading…"}
            </Button>
          </AlertDialogFooter>
        </AlertDialogContent>
      </AlertDialog>
    </>
  );
}
