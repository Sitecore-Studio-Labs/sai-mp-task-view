"use client";

import type {
  AssigneeOption,
  IEditTaskProvider,
  PlatformTask,
  UpdateTaskPayload,
} from "@mp/task-core";
import { EditTaskProvider as EditTaskContextProvider } from "@mp/task-core";
import {
  <%_ if (hasAssignees) { _%>
  useDebounce,
  usePlatformAssignees,
  usePlatformCurrentUser,
  <%_ } _%>
  <%_ if (hasPriorities) { _%>
  usePlatformPriorities,
  <%_ } _%>
  usePlatformUpdateIssue,
} from "@mp/ui";
import { useCallback, useMemo<%_ if (hasAssignees) { _%>, useState<%_ } _%> } from "react";

import { mapUserToAssignee } from "@/providers/shared/platformTaskProviderUtils";

type <%= className %>EditTaskProviderProps = {
  projectId: string;
  taskKey: string;
  task: PlatformTask;
  children: React.ReactNode;
};

export function <%= className %>EditTaskProvider({
  projectId,
  taskKey,
  task,
  children,
}: <%= className %>EditTaskProviderProps) {
  <%_ if (hasAssignees) { _%>
  const [assigneeSearch, setAssigneeSearch] = useState("");
  const assigneeSearchDebounced = useDebounce(assigneeSearch, 300);
  <%_ } _%>

  <%_ if (hasPriorities) { _%>
  const { data: priorities = [] } = usePlatformPriorities(projectId);
  <%_ } _%>
  <%_ if (hasAssignees) { _%>
  const { data: assigneesRaw = [], isLoading: assigneesLoading } = usePlatformAssignees(
    projectId,
    assigneeSearchDebounced,
  );
  const { data: currentUserRaw } = usePlatformCurrentUser();
  <%_ } _%>
  const updateIssue = usePlatformUpdateIssue(taskKey);

  <%_ if (hasAssignees) { _%>
  const assignees: AssigneeOption[] = useMemo(
    () => assigneesRaw.map(mapUserToAssignee),
    [assigneesRaw],
  );
  const currentUser: AssigneeOption | null = useMemo(
    () => (currentUserRaw ? mapUserToAssignee(currentUserRaw) : null),
    [currentUserRaw],
  );
  const initialAssignee: AssigneeOption | null = useMemo(
    () => (task.fields.assignee ? mapUserToAssignee(task.fields.assignee) : null),
    [task.fields.assignee],
  );
  <%_ } _%>

  const updateTask = useMemo(
    () => ({
      mutateAsync: async (payload: UpdateTaskPayload) => updateIssue.mutateAsync(payload),
      isPending: updateIssue.isPending,
      isError: updateIssue.isError,
      error: (updateIssue.error as Error | null) ?? null,
      reset: updateIssue.reset,
    }),
    [updateIssue],
  );

  <%_ if (hasAttachments) { _%>
  const uploadAttachments = useCallback(async (_taskKey: string, _files: File[]): Promise<void> => {
    // TODO: implement <%= platformDisplay %> attachment upload
  }, []);
  const existingAttachments = useMemo(
    () => (task.fields.attachment ?? []).map((a) => ({ id: a.id, filename: a.filename })),
    [task.fields.attachment],
  );
  <%_ } else { _%>
  const uploadAttachments = useCallback(async (_taskKey: string, _files: File[]): Promise<void> => {}, []);
  const existingAttachments: Array<{ id: string; filename: string }> = [];
  <%_ } _%>

  const defaultFormValues = useMemo(
    () => ({
      issueTypeId: <%- hasIssueTypes ? 'task.fields.issuetype?.id ?? ""' : '""' %>,
      summary: task.fields.summary ?? "",
      description: typeof task.fields.description === "string" ? task.fields.description : "",
      priority: <%- hasPriorities ? 'task.fields.priority?.id ?? ""' : '""' %>,
      parentIssueKey: <%- hasParentIssue ? 'task.fields.parent?.key ?? ""' : '""' %>,
      assignee: <%- hasAssignees ? 'task.fields.assignee?.accountId ?? ""' : '""' %>,
      dueDate: <%- hasDueDate ? 'task.fields.duedate ? new Date(task.fields.duedate) : null' : "null" %>,
    }),
    [task],
  );

  const value: IEditTaskProvider = useMemo(
    () => ({
      projectId,
      taskKey,
      formTitle: "Edit <%= platformDisplay %> Task",
      issueTypes: [],
      issueTypesLoading: false,
      priorities: <%- hasPriorities ? "priorities" : "[]" %>,
      assignees: <%- hasAssignees ? "assignees" : "[]" %>,
      assigneesLoading: <%- hasAssignees ? "assigneesLoading" : "false" %>,
      assigneeSearch: <%- hasAssignees ? "assigneeSearch" : '""' %>,
      setAssigneeSearch: <%- hasAssignees ? "setAssigneeSearch" : "() => {}" %>,
      currentUser: <%- hasAssignees ? "currentUser" : "null" %>,
      parentIssues: [],
      parentIssuesLoading: false,
      parentIssueSearch: "",
      setParentIssueSearch: () => {},
      getAllowedParentTypeNames: () => new Set<string>(),
      updateTask,
      uploadAttachments,
      existingAttachments,
      initialAssignee: <%- hasAssignees ? "initialAssignee" : "null" %>,
      defaultFormValues,
    }),
    [
      projectId,
      taskKey,
      <%_ if (hasPriorities) { _%>priorities,<%_ } _%>
      <%_ if (hasAssignees) { _%>assignees, assigneesLoading, assigneeSearch, currentUser, initialAssignee,<%_ } _%>
      updateTask,
      uploadAttachments,
      <%_ if (hasAttachments) { _%>existingAttachments,<%_ } _%>
      defaultFormValues,
    ],
  );

  return <EditTaskContextProvider value={value}>{children}</EditTaskContextProvider>;
}
