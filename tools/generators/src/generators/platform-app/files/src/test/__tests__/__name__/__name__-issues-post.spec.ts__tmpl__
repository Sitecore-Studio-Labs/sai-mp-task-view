import { beforeEach, describe, expect, it, vi } from "vitest";

const adapterMocks = vi.hoisted(() => ({
  getProjects: vi.fn(),
  getTasks: vi.fn(),
  createTask: vi.fn(),
  getComments: vi.fn(),
  createComment: vi.fn(),
  getTransitions: vi.fn(),
  changeStatus: vi.fn(),
}));

vi.mock("@/platforms/<%= className %>ServiceAdapter", () => ({
  <%= className %>ServiceAdapter: vi.fn(() => adapterMocks),
}));

import { PlatformApiError } from "@mp/task-core";
import { NextRequest } from "next/server";

import { <%= className %>AuthError } from "@/exceptions/<%= name %>Errors";

import { POST } from "../../../app/api/<%= name %>/issues/route";

vi.mock("@/helpers/<%= name %>UserId", () => ({
  get<%= className %>UserIdFromSession: vi.fn(),
}));

vi.mock("@/helpers/cookies", () => ({
  clear<%= className %>Cookie: vi.fn(),
}));

const { get<%= className %>UserIdFromSession } = await import("@/helpers/<%= name %>UserId");
const { clear<%= className %>Cookie } = await import("@/helpers/cookies");

function mockRequest(body: unknown) {
  return new NextRequest("http://localhost/api/<%= name %>/issues", {
    method: "POST",
    body: JSON.stringify(body),
    headers: { "Content-Type": "application/json" },
  });
}

describe("POST /api/<%= name %>/issues", () => {
  beforeEach(() => {
    vi.clearAllMocks();
  });

  it("returns 401 if no <%= platformDisplay %> session", async () => {
    vi.mocked(get<%= className %>UserIdFromSession).mockResolvedValue(null);

    const req = mockRequest({
      projectId: "proj-1",
      summary: "Test issue",
    });
    const res = await POST(req);
    const json = await res.json();

    expect(res.status).toBe(401);
    expect(json.error).toBe("No active <%= platformDisplay %> connection.");
  });

  it("returns 400 for invalid JSON", async () => {
    vi.mocked(get<%= className %>UserIdFromSession).mockResolvedValue("user-1");

    const req = new NextRequest("http://localhost/api/<%= name %>/issues", {
      method: "POST",
      body: "not-json",
      headers: { "Content-Type": "application/json" },
    });

    const res = await POST(req);
    const json = await res.json();

    expect(res.status).toBe(400);
    expect(json.error).toBe("Invalid JSON body.");
  });

  it("returns 400 if required fields are missing", async () => {
    vi.mocked(get<%= className %>UserIdFromSession).mockResolvedValue("user-1");

    const req = mockRequest({});
    const res = await POST(req);
    const json = await res.json();

    expect(res.status).toBe(400);
    expect(json.error).toBe("Validation failed.");
    expect(json.details).toBeDefined();
  });

  it("creates <%= platformDisplay %> task successfully", async () => {
    vi.mocked(get<%= className %>UserIdFromSession).mockResolvedValue("user-1");

    const mockTask = { id: "123", key: "TEST-1" };
    adapterMocks.createTask.mockResolvedValue(mockTask);

    const req = mockRequest({
      projectId: "proj-1",
      summary: "Test issue",
    });

    const res = await POST(req);
    const json = await res.json();

    expect(res.status).toBe(200);
    expect(json).toEqual(mockTask);
    expect(adapterMocks.createTask).toHaveBeenCalledWith({
      projectId: "proj-1",
      issueTypeId: "task",
      summary: "Test issue",
    });
  });

  it("validates dueDate format", async () => {
    vi.mocked(get<%= className %>UserIdFromSession).mockResolvedValue("user-1");

    const req = mockRequest({
      projectId: "proj-1",
      summary: "Test issue",
      dueDate: "invalid-date",
    });

    const res = await POST(req);
    const json = await res.json();

    expect(res.status).toBe(400);
    expect(json.error).toBe("Validation failed.");
  });

  it("handles <%= className %>AuthError and clears cookie", async () => {
    vi.mocked(get<%= className %>UserIdFromSession).mockResolvedValue("user-1");

    adapterMocks.createTask.mockRejectedValue(new <%= className %>AuthError("Unauthorized"));

    const req = mockRequest({
      projectId: "proj-1",
      summary: "Test issue",
    });

    const res = await POST(req);
    const json = await res.json();

    expect(res.status).toBe(401);
    expect(clear<%= className %>Cookie).toHaveBeenCalled();
    expect(json.error).toBe("Unauthorized");
  });

  it("handles PlatformApiError client errors", async () => {
    vi.mocked(get<%= className %>UserIdFromSession).mockResolvedValue("user-1");

    adapterMocks.createTask.mockRejectedValue(new PlatformApiError("Bad request", 400));

    const req = mockRequest({
      projectId: "proj-1",
      summary: "Test issue",
    });

    const res = await POST(req);
    const json = await res.json();

    expect(res.status).toBe(400);
    expect(json.error).toBe("Bad request");
  });

  it("handles generic errors", async () => {
    vi.mocked(get<%= className %>UserIdFromSession).mockResolvedValue("user-1");

    adapterMocks.createTask.mockRejectedValue(new Error("Something broke"));

    const req = mockRequest({
      projectId: "proj-1",
      summary: "Test issue",
    });

    const res = await POST(req);
    const json = await res.json();

    expect(res.status).toBe(500);
    expect(json.error).toBe("Internal server error.");
  });

  it("handles missing <%= platformDisplay %> connection error message", async () => {
    vi.mocked(get<%= className %>UserIdFromSession).mockResolvedValue("user-1");

    adapterMocks.createTask.mockRejectedValue(
      new Error("No active <%= platformDisplay %> connection found for user."),
    );

    const req = mockRequest({
      projectId: "proj-1",
      summary: "Test issue",
    });

    const res = await POST(req);
    const json = await res.json();

    expect(res.status).toBe(401);
    expect(clear<%= className %>Cookie).toHaveBeenCalled();
    expect(json.error).toBe("No active <%= platformDisplay %> connection.");
  });
});
