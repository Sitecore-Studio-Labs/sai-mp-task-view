import { beforeEach, describe, expect, it, vi } from "vitest";

const adapterMocks = vi.hoisted(() => ({
  getProjects: vi.fn(),
  getTasks: vi.fn(),
  createTask: vi.fn(),
  getComments: vi.fn(),
  createComment: vi.fn(),
  getTransitions: vi.fn(),
  changeStatus: vi.fn(),
}));

vi.mock("@/platforms/<%= className %>ServiceAdapter", () => ({
  <%= className %>ServiceAdapter: vi.fn(() => adapterMocks),
}));

import { NextRequest } from "next/server";

import { <%= className %>AuthError } from "@/exceptions/<%= name %>Errors";
import * as cookiesModule from "@/helpers/cookies";
import * as userIdModule from "@/helpers/<%= name %>UserId";

import { GET } from "../../../app/api/<%= name %>/projects/route";

vi.mock("@/helpers/<%= name %>UserId");
vi.mock("@/helpers/cookies");
vi.mock("@/lib/supabaseClient", () => ({
  createSupabaseServerClient: vi.fn().mockReturnValue({}),
}));

function createRequest(url = "http://localhost/api/<%= name %>/projects") {
  return new NextRequest(url);
}

describe("GET /api/<%= name %>/projects", () => {
  beforeEach(() => {
    vi.clearAllMocks();
  });

  it("returns empty array when no userId", async () => {
    vi.spyOn(userIdModule, "get<%= className %>UserIdFromSession").mockResolvedValue(null);

    const response = await GET(createRequest());
    const data = await response.json();

    expect(response.status).toBe(200);
    expect(data).toEqual([]);
  });

  it("returns projects when successful", async () => {
    const mockProjects = [{ id: "1", key: "key-1", name: "Test Project" }];

    vi.spyOn(userIdModule, "get<%= className %>UserIdFromSession").mockResolvedValue("user-123");
    adapterMocks.getProjects.mockResolvedValue(mockProjects);

    const response = await GET(createRequest());
    const data = await response.json();

    expect(response.status).toBe(200);
    expect(data).toEqual(mockProjects);
  });

  it("handles <%= className %>AuthError and clears cookie", async () => {
    vi.spyOn(userIdModule, "get<%= className %>UserIdFromSession").mockResolvedValue("user-123");
    adapterMocks.getProjects.mockRejectedValue(new <%= className %>AuthError("Unauthorized"));

    const clearSpy = vi.spyOn(cookiesModule, "clear<%= className %>Cookie").mockResolvedValue();

    const response = await GET(createRequest());
    const data = await response.json();

    expect(clearSpy).toHaveBeenCalled();
    expect(response.status).toBe(401);
    expect(data).toEqual({ error: "Unauthorized" });
  });

  it("returns empty array when no active <%= platformDisplay %> connection found", async () => {
    vi.spyOn(userIdModule, "get<%= className %>UserIdFromSession").mockResolvedValue("user-123");
    adapterMocks.getProjects.mockRejectedValue(
      new Error("No active <%= platformDisplay %> connection found for user."),
    );

    const clearSpy = vi.spyOn(cookiesModule, "clear<%= className %>Cookie").mockResolvedValue();

    const response = await GET(createRequest());
    const data = await response.json();

    expect(clearSpy).toHaveBeenCalled();
    expect(response.status).toBe(200);
    expect(data).toEqual([]);
  });

  it("returns empty array when no <%= platformDisplay %> site selected", async () => {
    vi.spyOn(userIdModule, "get<%= className %>UserIdFromSession").mockResolvedValue("user-123");
    adapterMocks.getProjects.mockRejectedValue(
      new Error(
        "No <%= platformDisplay %> site selected. Please reconnect to <%= platformDisplay %> and select a site.",
      ),
    );

    const response = await GET(createRequest());
    const data = await response.json();

    expect(response.status).toBe(200);
    expect(data).toEqual([]);
  });

  it("returns 500 for unknown errors", async () => {
    vi.spyOn(userIdModule, "get<%= className %>UserIdFromSession").mockResolvedValue("user-123");
    adapterMocks.getProjects.mockRejectedValue(new Error("Unexpected failure"));

    const consoleSpy = vi.spyOn(console, "error").mockImplementation(() => {});

    const response = await GET(createRequest());
    const data = await response.json();

    expect(consoleSpy).toHaveBeenCalled();
    expect(response.status).toBe(500);
    expect(data).toEqual({ error: "Internal server error." });
  });
});
